# Autonaut Icons — client env
# Copy to .env.local for local dev, or add to Vercel env vars for production.
# Leave blank to keep the CMS disabled (site still works read-only).
# See CMS-SETUP.md for how to create the GitHub OAuth App these come from.

VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REPO=elsway/elsway-icons
VITE_GITHUB_BRANCH=main

# Server-only (Vercel env var, NOT prefixed with VITE_ — never put this in
# a client-exposed variable or commit it). Used only inside api/github-callback.
# GITHUB_CLIENT_SECRET=
